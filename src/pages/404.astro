---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="narrow" style="padding-block: clamp(4rem, 10vw, 8rem);">
    <h1 style="font-size: clamp(2.2rem, 6vw, 3.4rem); font-weight: 800;">This page doesn't exist</h1>
    <p style="color: var(--muted); margin: 1rem 0 2rem;">It may have moved or been removed.</p>
    <a class="btn btn-primary" href="/">Go to the homepage</a>
  </section>
</Base>
