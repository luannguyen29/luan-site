---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string; }
const { title, description = profile.intro } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} – ${profile.role}`;
const path = Astro.url.pathname;
const isHome = path === '/';
const nav = [
  { href: isHome ? '#expertise' : '/#expertise', label: 'Expertise' },
  { href: isHome ? '#approach' : '/#approach', label: 'Approach' },
  { href: '/blog/', label: 'Blog', current: path.startsWith('/blog') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1e3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog" href="/rss.xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/avatar.jpg', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}>
          <span class="mark" aria-hidden="true">{profile.initials}</span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <button class="menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
          <span></span><span></span>
        </button>
        <nav id="site-nav" class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn btn-primary nav-cta" href={`mailto:${profile.email}`}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container foot">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p class="foot-links">
          <a href={`mailto:${profile.email}`}>Email</a>
          {profile.github && <a href={profile.github}>GitHub</a>}
          {profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('site-nav');
      if (btn && nav) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.body.classList.toggle('nav-open', open);
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
        matchMedia('(min-width: 760px)').addEventListener('change', () => set(false));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 0.5rem; background: var(--surface); padding: 0.5rem 1rem; z-index: 100; border-radius: 6px; }
  .skip:focus { left: 1rem; }

  .topbar { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); text-decoration: none; font-weight: 700; min-width: 0; }
  .mark { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 8px; background: var(--ink); color: var(--bg); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.02em; flex: none; }
  .brand-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .nav { display: flex; align-items: center; gap: 1.75rem; }
  .nav a:not(.btn) { color: var(--muted); text-decoration: none; font-weight: 500; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--ink); }
  .nav-cta { min-height: 2.4rem; padding: 0 1.1rem; }

  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); cursor: pointer; padding: 0; position: relative; flex: none; }
  .menu-btn span { position: absolute; left: 50%; width: 1.1rem; height: 2px; background: var(--ink); border-radius: 2px; transform: translateX(-50%); transition: transform .2s; }
  .menu-btn span:first-child { top: calc(50% - 4px); }
  .menu-btn span:last-child { top: calc(50% + 3px); }
  .nav-open .menu-btn span:first-child { transform: translateX(-50%) translateY(3.5px) rotate(45deg); }
  .nav-open .menu-btn span:last-child { transform: translateX(-50%) translateY(-3.5px) rotate(-45deg); }

  @media (max-width: 759px) {
    .menu-btn { display: block; }
    .nav { position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem 1.25rem 1.25rem; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); display: none; }
    .nav-open .nav { display: flex; }
    .nav a:not(.btn) { padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
    .nav-cta { margin-top: 1rem; min-height: 2.9rem; }
  }

  .footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--muted); font-size: 0.92rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; }
  .foot p { margin: 0; }
  .foot-links { display: flex; gap: 1.25rem; }
  .foot-links a { color: var(--muted); text-decoration: none; }
  .foot-links a:hover { color: var(--ink); }
</style>
